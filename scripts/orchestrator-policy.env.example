# Example policy for openclaw-orchestrator-userctl
# Copy to /etc/openclaw-orchestrator/policy.env (root-owned, 0640)

# Allowlist regex for managed usernames
ORCH_ALLOW_REGEX='^oc_[a-z0-9_]{2,24}$'

# Space-delimited deny list (always blocked)
ORCH_FORBIDDEN_USERS='root ec2-user nobody daemon bin sys ubuntu admin'

# Systemd service template; %s is replaced by username
# Must match the system service files created by add_user
ORCH_SERVICE_TEMPLATE='openclaw-gateway@%s.service'

# Path to the openclaw node binary (used for service file creation)
ORCH_OPENCLAW_BIN='/home/ubuntu/.npm-global/lib/node_modules/openclaw/dist/index.js'

# Symlink path for system-wide openclaw access
ORCH_OPENCLAW_SYMLINK='/usr/local/bin/openclaw'

# Base port for user gateways. Each user gets base + (uid % 1000)
ORCH_GATEWAY_PORT_BASE='18800'

# Health check command shown at second checkpoint; %s = username
ORCH_HEALTH_CHECK_CMD_TEMPLATE='sudo -iu %s openclaw health'

# Slack automation (optional)
# Set this to enable automatic Slack app creation during add_user.
# Obtain via: slack login (Slack CLI) — requires workspace admin permissions.
# Format: xoxe-1-... (refresh token from Slack CLI)
# Leave unset to fall back to manual manifest-import instructions.
ORCH_SLACK_CONFIG_TOKEN=''
