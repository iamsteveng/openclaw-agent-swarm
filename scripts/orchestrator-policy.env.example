# Example policy for openclaw-orchestrator-userctl
# Copy to /etc/openclaw-orchestrator/policy.env (root-owned, 0640)

# Allowlist regex for managed usernames
ORCH_ALLOW_REGEX='^oc_[a-z0-9_]{2,24}$'

# Space-delimited deny list (always blocked)
ORCH_FORBIDDEN_USERS='root ec2-user nobody daemon bin sys ubuntu admin'

# Systemd service template; %s is replaced by username
ORCH_SERVICE_TEMPLATE='openclaw-agent@%s.service'
